paper/
*.tex
*.pdf
*.cls
*.bbl
*.blg
*.aux
*.log
*.out
*.spl
*.synctex.gz
*.fls
*.fdb_latexmk

# Editor & System Artifacts
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
